# ignore all dot-prefixed directories ...
.*/
# ... except the ones we intentionally track (CI, etc.)
!.github/

# ignore large run outputs and local secrets
results/**
!results/proxies/.gitkeep
reports/**
tmp/**
.venv/**
*.tfstate
*.tfvars
.env

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
